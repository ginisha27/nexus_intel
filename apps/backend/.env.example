DATABASE_URL="postgresql://postgres:postgres@localhost:5433/nexus_intel?schema=public"
PORT=4000
FRONTEND_URL="http://localhost:5173"
# Set to "production" when deployed — this flips the session cookie's
# Secure flag on (see src/lib/auth.ts) and is required for cookies to
# actually work in production. Leave unset/"development" locally.
NODE_ENV="development"

# Used once by prisma/seedAdminUser.ts to create the first Administrator
# account. Not read anywhere else — safe to remove after first setup.
ADMIN_NAME="Administrator"
ADMIN_EMAIL="admin@nexus.local"
# If unset, seedAdminUser.ts generates and prints a random one instead.
# ADMIN_PASSWORD=""

# AI Assessment (Gemini) — used by POST /api/investigations/:displayId/ai-assessment.
# Get a key at https://ai.google.dev/gemini-api/docs/api-key
# If unset, the endpoint still works but falls back to a deterministic
# templated narrative instead of a real Gemini explanation.
# ⚠ This file previously had a real, working key committed here instead
# of a placeholder — that key (and the OpenAI/Groq/ingest ones below) must
# be rotated at their respective providers; a committed key is compromised
# the moment it's committed, whether or not the repo is public.
GEMINI_API_KEY="your-gemini-api-key"
# Optional — defaults to Google's floating "-latest" alias if unset.
GEMINI_MODEL="gemini-flash-latest"
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"
GROQ_API_KEY="your-groq-api-key"
# Optional — defaults to openai/gpt-oss-120b if unset. (llama-3.3-70b-versatile
# / llama-3.1-8b-instant were decommissioned by Groq on 2026-08-16.)
GROQ_MODEL="openai/gpt-oss-120b"
# Shared secret the producer script (see /producer) must send as the
# x-ingest-key header on POST /api/ingest/event. Anyone with this value
# can push events into the live pipeline, so treat it like a password.
INGEST_SECRET_KEY="generate-a-new-random-value-here"
